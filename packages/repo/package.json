{
  "name": "@binder/repo",
  "version": "0.0.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks.ts",
      "default": "./src/mocks.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./local": {
      "types": "./src/local/index.ts",
      "default": "./src/local/index.ts"
    }
  },
  "scripts": {
    "format": "bun prettier --write --ignore-path ../../.prettierignore .",
    "lint": "bun eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun lint && bun format && bun typecheck && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@binder/utils": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "diff-match-patch-es": "1.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
